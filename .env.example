# ------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# Na Vercel ou na Netlify, cadastre as mesmas variáveis no painel do projeto.
# ------------------------------------------------------------------

# Endereço público definitivo do site, sem barra no final.
# Usado em links canônicos, Open Graph, sitemap.xml e robots.txt.
VITE_SITE_URL=https://www.seudominio.com.br

# Endpoint que recebe o formulário de contato (POST em JSON).
# Compatível com Formspree (https://formspree.io/f/xxxxxxx), Web3Forms
# (https://api.web3forms.com/submit) ou um endpoint próprio.
# Enquanto estiver vazio, o formulário informa que o envio online
# ainda não está disponível — nenhuma mensagem é simulada.
VITE_FORM_ENDPOINT=

# Opcional: chave pública exigida por alguns serviços (ex.: Web3Forms).
VITE_FORM_ACCESS_KEY=
